# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real keys.
#
# Setup:
#   cp .env.example .env
#   chmod 600 .env
#   # then edit .env and paste your key
#
# Or use ./dev.sh which does this for you.

# Required: Anthropic API key for the agent.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the default model.
# DCP_MODEL=claude-opus-4-7

# Optional: where the vault lives. Defaults to ./vault relative to repo root.
# DCP_VAULT_DIR=

# Optional: disable the auto git commit/push after each agent run.
# DCP_AUTOCOMMIT=1
# DCP_AUTOPUSH=1
