# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real keys.
#
# Local setup:
#   cp .env.example .env
#   chmod 600 .env
#   # then edit .env and paste your key
#
# In GitHub Codespaces, do NOT use a .env file — set this as a
# Codespace secret instead (Settings -> Codespaces -> Secrets).
# The devcontainer declares ANTHROPIC_API_KEY as a required secret
# and it will be injected as an env var automatically.

# Required: Anthropic API key for the agent.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the default model.
# DCP_MODEL=claude-opus-4-7

# Optional: where the vault lives. Defaults to ./vault relative to repo root.
# DCP_VAULT_DIR=

# Optional: disable the auto git commit/push after each agent run.
# DCP_AUTOCOMMIT=1
# DCP_AUTOPUSH=1
